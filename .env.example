# --- LLM ---------------------------------------------------------------
# Gemini key from https://aistudio.google.com/apikey (free tier)
GOOGLE_API_KEY=
# provider:model, see langchain init_chat_model. Flash-Lite has the largest free quota.
# Fully offline: ollama:qwen3:8b
LLM_MODEL=google_genai:gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=google_genai:gemini-3.8-flash
# golden trio search (free tier); empty = TF-IDF only. Needs GOOGLE_API_KEY.
EMBED_MODEL=gemini-embedding-001

# --- Data --------------------------------------------------------------
# local = synthetic DuckDB copy of thelook (no GCP needed); bigquery = real dataset
DATA_BACKEND=local
# GCP project that pays for BigQuery jobs (BigQuery sandbox is free)
GCP_PROJECT=
MAX_BYTES_BILLED=2000000000

# --- Misc --------------------------------------------------------------
# salt for customer pseudonyms (C-xxxxxx)
PII_SALT=change-me
# optional tracing: LANGSMITH_TRACING=true + LANGSMITH_API_KEY=...
# Langfuse UI port for docker compose (default 3000)
# LANGFUSE_PORT=3000
# Trace runs outside Docker (uv run retail-agent, scripts/live_demo.py) to the local
# Langfuse from docker compose; inside compose these are set for you.
# LANGFUSE_PUBLIC_KEY=pk-lf-local
# LANGFUSE_SECRET_KEY=sk-lf-local
# LANGFUSE_HOST=http://localhost:3000
